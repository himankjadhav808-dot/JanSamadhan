PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/civic_social_network
NODE_ENV=development
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id_here

# Email — leave blank in dev to use Ethereal (auto preview URL logged to console)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="JanSamadhan" <no-reply@jansamadhan.app>
# Gemini AI — used for auto-translating Hindi/Hinglish issue submissions
GEMINI_API_KEY=your_gemini_api_key_here
